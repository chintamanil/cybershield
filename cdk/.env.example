# AWS Configuration
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# Environment
ENVIRONMENT=dev  # dev, staging, prod

# Project Configuration
PROJECT_NAME=cybershield

# Domain Configuration
DOMAIN_NAME=cybershield-ai.com
CERTIFICATE_VALIDATION_METHOD=DNS

# Network Configuration
VPC_CIDR=10.0.0.0/16
ENABLE_NAT_GATEWAY=true
ENABLE_VPN_GATEWAY=false

# Database Configuration
DB_INSTANCE_CLASS=db.t3.micro
DB_ALLOCATED_STORAGE=20
DB_ENGINE_VERSION=15.7
DB_NAME=cybershield
DB_USERNAME=cybershield_admin
BACKUP_RETENTION_DAYS=7

# Redis Configuration
REDIS_NODE_TYPE=cache.t3.micro
REDIS_ENGINE_VERSION=7.0
ENABLE_AUTH_TOKEN=true
ENABLE_TRANSIT_ENCRYPTION=true
ENABLE_AT_REST_ENCRYPTION=true

# OpenSearch Configuration
ENABLE_OPENSEARCH=false
OPENSEARCH_INSTANCE_TYPE=t3.small.search
OPENSEARCH_INSTANCE_COUNT=1
OPENSEARCH_VOLUME_SIZE=20

# ECS Configuration
BACKEND_CPU=1024
BACKEND_MEMORY=2048
BACKEND_MIN_CAPACITY=1
BACKEND_MAX_CAPACITY=10

FRONTEND_CPU=512
FRONTEND_MEMORY=1024
FRONTEND_MIN_CAPACITY=1
FRONTEND_MAX_CAPACITY=5

# Feature Flags
ENABLE_SPOT_INSTANCES=false
ENABLE_DELETION_PROTECTION=true
ENABLE_BACKUP=true
ENABLE_MONITORING=true
ENABLE_LOGGING=true
ENABLE_ACCESS_LOGS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_PERFORMANCE_INSIGHTS=false
ENABLE_EFS_FOR_MILVUS=false
ENABLE_BEDROCK_FINETUNING=false
ENABLE_BEDROCK_VPC_ENDPOINT=false

# Monitoring Configuration
CLOUDWATCH_LOG_RETENTION_DAYS=14
MONITORING_INTERVAL=60

# Health Check Configuration
BACKEND_HEALTH_CHECK_PATH=/health
FRONTEND_HEALTH_CHECK_PATH=/

# Application Configuration
DEBUG=False
LOG_LEVEL=INFO
APPLE_SILICON_ACCELERATION=true
