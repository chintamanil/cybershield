# CyberShield Terraform Variables
# Copy this file to terraform.tfvars and customize values

# Basic Configuration
project_name = "cybershield"
environment  = "dev"  # dev, staging, or prod
aws_region   = "us-east-1"

# Domain Configuration
domain_name = "cybershield-ai.com"  # Replace with your domain

# Networking
vpc_cidr = "10.0.0.0/16"

# Database Configuration
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
db_engine_version    = "15.13"
db_name             = "cybershield"
db_username         = "cybershield_admin"

# Redis Configuration  
redis_node_type           = "cache.t3.micro"
redis_engine_version      = "7.0"
redis_parameter_group_family = "redis7.x"

# ECS Configuration
backend_cpu     = 512
backend_memory  = 1024
frontend_cpu    = 256  
frontend_memory = 512

backend_min_capacity  = 1
backend_max_capacity  = 3
frontend_min_capacity = 1
frontend_max_capacity = 2

# Feature Flags
enable_nat_gateway     = true
enable_opensearch      = false
enable_bedrock_finetuning = false
enable_monitoring      = true
enable_logging        = true
enable_backup         = true

# Application Configuration
environment_variables = {
  ENVIRONMENT = "dev"
  LOG_LEVEL   = "INFO"
  DEBUG       = "false"
}

# Health Check Paths
backend_health_check_path  = "/health"
frontend_health_check_path = "/health"
